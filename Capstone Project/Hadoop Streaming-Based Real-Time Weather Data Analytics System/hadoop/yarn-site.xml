<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  YARN Site Configuration Template
  Defines ResourceManager coordinator, NodeManager container managers, and memory allocation limits.
-->
<configuration>
    <!-- ResourceManager Hostname -->
    <property>
        <name>yarn.resourcemanager.hostname</name>
        <value>hadoop-master</value>
        <description>The hostname of the YARN ResourceManager coordinator.</description>
    </property>

    <!-- Auxiliary Services (MapReduce Shuffle Provider) -->
    <property>
        <name>yarn.nodemanager.aux-services</name>
        <value>mapreduce_shuffle</value>
    </property>
    <property>
        <name>yarn.nodemanager.aux-services.mapreduce_shuffle.class</name>
        <value>org.apache.hadoop.mapred.ShuffleHandler</value>
    </property>

    <!-- ResourceManager Web UI & RPC Endpoints -->
    <property>
        <name>yarn.resourcemanager.webapp.address</name>
        <value>hadoop-master:8088</value>
        <description>YARN ResourceManager Web UI (Port 8088).</description>
    </property>
    <property>
        <name>yarn.resourcemanager.resource-tracker.address</name>
        <value>hadoop-master:8031</value>
    </property>
    <property>
        <name>yarn.resourcemanager.scheduler.address</name>
        <value>hadoop-master:8030</value>
    </property>

    <!-- NodeManager Resource Constraints -->
    <property>
        <name>yarn.nodemanager.resource.memory-mb</name>
        <value>3072</value>
        <description>Amount of physical memory in MB that can be allocated for containers per worker node.</description>
    </property>
    <property>
        <name>yarn.scheduler.minimum-allocation-mb</name>
        <value>512</value>
    </property>
    <property>
        <name>yarn.scheduler.maximum-allocation-mb</name>
        <value>3072</value>
    </property>
    <property>
        <name>yarn.nodemanager.resource.cpu-vcores</name>
        <value>2</value>
        <description>Number of vCPU cores allocatable on each NodeManager.</description>
    </property>

    <!-- Disable Virtual Memory Check (Essential for Ubuntu Linux Cloud VMs) -->
    <property>
        <name>yarn.nodemanager.vmem-check-enabled</name>
        <value>false</value>
        <description>Disables strict virtual memory ratios preventing false-positive OOM container kills.</description>
    </property>

    <!-- Log Aggregation for Post-Mortem Diagnostics -->
    <property>
        <name>yarn.log-aggregation-enable</name>
        <value>true</value>
    </property>
</configuration>
