<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Hadoop Distributed File System (HDFS) Configuration Template
  Defines replication factor, NameNode/DataNode directories, and HTTP Web UIs.
-->
<configuration>
    <!-- Replication Factor matched to 2 Worker Nodes -->
    <property>
        <name>dfs.replication</name>
        <value>2</value>
        <description>Default block replication count across cluster DataNodes.</description>
    </property>

    <!-- NameNode Metadata Storage Directory -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///usr/local/hadoop/data/hdfs/namenode</value>
        <description>Determines where on the local filesystem the DFS NameNode stores metadata.</description>
    </property>

    <!-- DataNode Block Storage Directory -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///usr/local/hadoop/data/hdfs/datanode</value>
        <description>Determines where on the local filesystem DFS DataNodes store blocks.</description>
    </property>

    <!-- Secondary NameNode Checkpoint Directory -->
    <property>
        <name>dfs.namenode.checkpoint.dir</name>
        <value>file:///usr/local/hadoop/data/hdfs/namesecondary</value>
        <description>Secondary NameNode checkpoint directory.</description>
    </property>

    <!-- NameNode Web UI Address (Hadoop 3.x default: 9870) -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>hadoop-master:9870</value>
        <description>NameNode Web UI listening address.</description>
    </property>

    <!-- Secondary NameNode Web UI Address -->
    <property>
        <name>dfs.namenode.secondary.http-address</name>
        <value>hadoop-master:9868</value>
        <description>Secondary NameNode Web UI listening address.</description>
    </property>

    <!-- Default HDFS Block Size (128 MB) -->
    <property>
        <name>dfs.blocksize</name>
        <value>134217728</value>
        <description>Default HDFS block size (128MB).</description>
    </property>

    <!-- WebHDFS REST API -->
    <property>
        <name>dfs.webhdfs.enabled</name>
        <value>true</value>
        <description>Enables WebHDFS REST API access for data ingestion pipelines.</description>
    </property>

    <!-- Permissions Checking -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
        <description>Disable strict POSIX permissions for academic cloud sandbox operations.</description>
    </property>
</configuration>
