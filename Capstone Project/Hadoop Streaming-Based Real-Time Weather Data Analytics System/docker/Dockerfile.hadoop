# ==============================================================================
# Dockerfile: Apache Hadoop 3.3.6 Base Cluster Node Image
# Project: Hadoop Streaming-Based Real-Time Weather Data Analytics System
# ==============================================================================

FROM ubuntu:22.04

LABEL maintainer="Weather Analytics Capstone Team"
LABEL description="Ubuntu 22.04 base container with Java 8, Hadoop 3.3.6, and Python 3 analytics dependencies"

ENV DEBIAN_FRONTEND=noninteractive

# 1. Install Prerequisites and System Utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-8-jdk \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    openssh-server \
    openssh-client \
    pdsh \
    wget \
    curl \
    iputils-ping \
    net-tools \
    locales \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set UTF-8 Locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# 2. Configure Environment Variables
ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
ENV HADOOP_HOME=/usr/local/hadoop
ENV HADOOP_CONF_DIR=${HADOOP_HOME}/etc/hadoop
ENV HADOOP_LOG_DIR=${HADOOP_HOME}/logs
ENV PATH=${PATH}:${JAVA_HOME}/bin:${HADOOP_HOME}/bin:${HADOOP_HOME}/sbin
ENV HADOOP_STREAMING_JAR=${HADOOP_HOME}/share/hadoop/tools/lib/hadoop-streaming-3.3.6.jar

# 3. Download and Install Apache Hadoop 3.3.6
RUN echo "Downloading Apache Hadoop 3.3.6..." && \
    wget -q https://archive.apache.org/dist/hadoop/common/hadoop-3.3.6/hadoop-3.3.6.tar.gz && \
    tar -xzf hadoop-3.3.6.tar.gz -C /usr/local/ && \
    mv /usr/local/hadoop-3.3.6 ${HADOOP_HOME} && \
    rm hadoop-3.3.6.tar.gz

# 4. Create HDFS & Runtime Data Directories
RUN mkdir -p /hadoop/dfs/name && \
    mkdir -p /hadoop/dfs/data && \
    mkdir -p /hadoop/dfs/namesecondary && \
    mkdir -p ${HADOOP_LOG_DIR} && \
    mkdir -p /tmp/hadoop-pids

# 5. Configure SSH for Passwordless Intra-Cluster Communication
RUN mkdir -p /var/run/sshd && \
    mkdir -p /root/.ssh && \
    ssh-keygen -t rsa -P "" -f /root/.ssh/id_rsa && \
    cat /root/.ssh/id_rsa.pub >> /root/.ssh/authorized_keys && \
    chmod 700 /root/.ssh && \
    chmod 600 /root/.ssh/authorized_keys

RUN echo "Host hadoop-master hadoop-worker1 hadoop-worker2 localhost 127.0.0.1" >> /root/.ssh/config && \
    echo "    StrictHostKeyChecking no" >> /root/.ssh/config && \
    echo "    UserKnownHostsFile /dev/null" >> /root/.ssh/config && \
    echo "    LogLevel ERROR" >> /root/.ssh/config && \
    chmod 600 /root/.ssh/config

# 6. Configure PDSH RCMD Module
ENV PDSH_RCMD_TYPE=ssh

# 7. Install Python Requirements
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# 8. Copy Entrypoint & Configs
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /app

EXPOSE 9870 9000 8088 19888 8501 9864 8042

ENTRYPOINT ["/entrypoint.sh"]
