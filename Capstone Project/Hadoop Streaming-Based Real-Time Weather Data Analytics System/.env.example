# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure with your specific cloud VM details.
# DO NOT commit .env with actual IP addresses or API keys.
# ==============================================================================

# Docker Cluster Networking (Local Docker Compose Services)
HADOOP_MASTER_HOST=hadoop-master
WORKER1_HOST=hadoop-worker1
WORKER2_HOST=hadoop-worker2

# Cloud Cluster Networking (Google Cloud Platform / AWS / Azure Compute Instances)
MASTER_PRIVATE_IP=10.128.0.2
MASTER_PUBLIC_IP=34.100.100.1
WORKER1_PRIVATE_IP=10.128.0.3
WORKER2_PRIVATE_IP=10.128.0.4

# Hadoop & Java Runtime Paths
JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
HADOOP_HOME=/usr/local/hadoop
HADOOP_STREAMING_JAR=/usr/local/hadoop/share/hadoop/tools/lib/hadoop-streaming-3.3.6.jar

# Application & Ingestion Settings
WEATHER_DATA_SOURCE=SIMULATOR  # Options: SIMULATOR, API
WEATHER_API_KEY=your_openweather_api_key_here
INGESTION_INTERVAL_SECONDS=10
HADOOP_JOB_INTERVAL_SECONDS=60

# HDFS Root Directory
HDFS_WEATHER_ROOT=/weather

